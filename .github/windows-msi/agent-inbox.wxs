<?xml version="1.0" encoding="utf-8"?>
<!--
  The per-user Windows MSI (#87, PR 2b), built by .github/workflows/windows-msi.yml
  from the verified Windows x64 folder with the WiX release pinned in
  installer.json. build-msi.ps1 passes every $(var.*) value with -d.

  - Per-user and unelevated: Scope="perUser", installed to
    %LOCALAPPDATA%\Programs\Agent Inbox, the same folder for every version, so a
    major upgrade replaces the app in place. A second build of the same version
    (another pull request's artifact, or one commit built twice) has its own
    ProductCode, so AllowSameVersionUpgrades makes it replace the installed build
    too, rather than install beside it as a second product that shares every
    component; build-msi.ps1 waives ICE61, which flags exactly that.
  - The whole folder is harvested with Files, so the installed tree can be
    compared byte for byte with the folder's verified tree digest.
  - The Start-menu shortcut carries the AppUserModelID and toast activator CLSID
    that Windows notifications need; electron/windows-app.cjs sets the same two
    values in the app. The MSI owns the CLSID's LocalServer32 registration, so
    uninstall removes it, and keeps %USERPROFILE%\.agent-inbox, which it never
    installs.
  - Windows Installer reports Windows 10 and 11 as 6.3, so the minimum Windows
    build is read from the registry.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="$(var.ProductName)"
    Manufacturer="$(var.Manufacturer)"
    Version="$(var.Version)"
    UpgradeCode="$(var.UpgradeCode)"
    Scope="perUser"
    Language="1033"
    Compressed="yes">
    <SummaryInformation Description="$(var.ProductName) $(var.Version)" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="AGENTINBOXWINDOWSBUILD">
      <RegistrySearch
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
        Name="CurrentBuildNumber"
        Type="raw"
        Bitness="always64" />
    </Property>
    <Launch
      Condition="Installed OR AGENTINBOXWINDOWSBUILD &gt;= $(var.MinimumWindowsBuild)"
      Message="[ProductName] needs Windows 10 or 11, build $(var.MinimumWindowsBuild) or later." />

    <Icon Id="AgentInbox.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AgentInbox.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/shariqh/agent-inbox" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="$(var.ProductName)">
      <Files Directory="INSTALLFOLDER" Include="$(var.AppDir)\**" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ToastActivator" />
    </Feature>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{5DB23DD7-6096-4B82-9CD9-908AE530B17F}">
        <Shortcut
          Id="AgentInboxShortcut"
          Name="$(var.ProductName)"
          Description="Local attention inbox for coding agents"
          Target="[INSTALLFOLDER]$(var.ProductName).exe"
          WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="$(var.AppUserModelId)" />
          <ShortcutProperty Key="System.AppUserModel.ToastActivatorCLSID" Value="$(var.ToastActivatorClsid)" />
        </Shortcut>
        <RegistryValue
          Root="HKCU"
          Key="Software\$(var.ProductName)\Installer"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Electron 43 writes these value names for its toast activator at the first notification; the MSI owns them, so uninstall removes them. -->
    <Component Id="ToastActivator" Directory="INSTALLFOLDER" Guid="{9639C28E-13C4-4208-B66B-550A0CB93154}">
      <RegistryValue
        Root="HKCU"
        Key="Software\Classes\CLSID\$(var.ToastActivatorClsid)"
        Type="string"
        Value="$(var.ProductName) Notification Activator"
        KeyPath="yes" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Classes\CLSID\$(var.ToastActivatorClsid)"
        Name="CustomActivator"
        Type="integer"
        Value="1" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Classes\CLSID\$(var.ToastActivatorClsid)\LocalServer32"
        Type="string"
        Value="&quot;[INSTALLFOLDER]$(var.ProductName).exe&quot;" />
    </Component>
  </Package>
</Wix>
