{
  "name": "agent-inbox",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-inbox-mcp": "./dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "mcp": "tsx src/mcp-server.ts",
    "view": "tsx src/viewer-server.ts",
    "electron": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:app": "bash scripts/package-app.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.3",
    "@electron/rebuild": "^4.2.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "electron": "^43.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@43.1.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
