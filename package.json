{
  "name": "agent-inbox",
  "version": "0.1.0",
  "description": "Local, cross-project attention inbox for coding agents",
  "private": true,
  "license": "MIT",
  "author": "Shariq Hirani",
  "repository": {
    "type": "git",
    "url": "https://github.com/shariqh/agent-inbox.git"
  },
  "bugs": {
    "url": "https://github.com/shariqh/agent-inbox/issues"
  },
  "homepage": "https://github.com/shariqh/agent-inbox#readme",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "agent-inbox-mcp": "./dist/mcp-server.js",
    "agent-inbox-hook": "./dist/hook-cli.js",
    "agent-inbox-watch": "./dist/watch-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "mcp": "tsx src/mcp-server.ts",
    "view": "tsx src/viewer-server.ts",
    "hook": "tsx src/hook-cli.ts",
    "watch": "tsx src/watch-cli.ts",
    "generate:icons": "bash scripts/generate-icons.sh",
    "install:agents": "bash scripts/install-agents.sh",
    "install:hooks": "bash scripts/install-hooks.sh",
    "electron": "electron .",
    "stage:runtime": "node scripts/stage-runtime.mjs",
    "runtime:payload": "node scripts/runtime-payload.mjs",
    "package:smoke": "vitest run test/runtime-payload.test.ts test/install-runtime.test.ts test/setup-runner.test.ts test/package-stamp.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package:app": "bash scripts/package-app.sh"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.3",
    "@electron/rebuild": "^4.2.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^24.0.0",
    "electron": "^43.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@43.1.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
