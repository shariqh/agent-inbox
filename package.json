{
  "name": "agent-inbox",
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "bin": { "agent-inbox-mcp": "./dist/mcp-server.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
