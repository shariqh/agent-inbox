        <section class="panel" id="dashboard" role="tabpanel" hidden=""><div class="dashboard"><div class="dash-head"><div class="dash-chips" role="group" aria-label="Lanes"><button type="button" class="dash-chip att" data-dash-chip="needs" data-dashboard-focus-key="chip:needs" aria-label="Needs you: 1"><span class="dash-chip-label">Needs you</span><b class="dash-chip-count">1</b></button><button type="button" class="dash-chip" data-dash-chip="working" data-dashboard-focus-key="chip:working" aria-label="Working: 0"><span class="dash-chip-label">Working</span><b class="dash-chip-count">0</b></button><button type="button" class="dash-chip" data-dash-chip="quiet" data-dashboard-focus-key="chip:quiet" aria-label="Quiet: 0"><span class="dash-chip-label">Quiet</span><b class="dash-chip-count">0</b></button></div><div class="dash-head-actions"><button class="ah-new" type="button" data-dashboard-focus-key="ah:new" hidden="">＋ New session…</button></div></div><p class="ah-note" hidden=""></p><p class="dash-since" hidden="" title=""></p><section class="dashboard-card needs-you-lane" aria-labelledby="needsYouLaneTitle"><div class="dashboard-card-head ny-head"><h2 id="needsYouLaneTitle" tabindex="-1">Needs you</h2><button class="ny-later" type="button" hidden="" title="Open the Inbox’s Later section" data-dashboard-focus-key="ny:later"></button><button class="ny-review" type="button" data-shortcut-id="review" data-dashboard-focus-key="ny:review" data-shortcut="T" aria-description="Keyboard shortcut: T." aria-keyshortcuts="t">Review queue</button></div><div class="ny-cards" role="list" aria-label="Asks waiting on you"><article class="ny-card" data-ny-ask="<uuid>" data-dashboard-focus-key="ny:<uuid>" role="listitem" tabindex="0" style="--ny-project: oklch(0.72 0.14 220);" aria-label="Ship it? alpha · claude · main. asked just now. no session"><div class="ny-meta"><i class="ny-dot" aria-hidden="true"></i><span class="ny-project">alpha</span><span class="ny-agent">claude</span><span class="ny-branch">main</span><span class="ny-age">now</span><span class="ny-session">no session</span><b class="ny-kind" hidden="">Hand-off</b><b class="ny-draft" hidden="">Draft</b></div><div class="ny-title" title="Ship it?">Ship it?</div><div class="ny-next">One ask.</div><div class="ny-plan" hidden=""></div></article></div><p class="ny-empty" hidden="">Nothing in this view is waiting on you.</p></section><div class="dashboard-grid"><div class="dash-split"><div class="agents-home"><section class="dashboard-card ah-lane working-lane" data-ah-lane="working" aria-labelledby="workingLaneTitle"><div class="dashboard-card-head ah-lane-head"><h2 id="workingLaneTitle" tabindex="-1">Working</h2></div><p class="ah-outside" hidden=""><span class="ah-outside-text"></span> · <button class="ah-outside-all" type="button" data-dashboard-focus-key="ah:outside-all">Show all</button></p><div class="ah-groups"></div><div class="ah-empty"><svg class="dashboard-empty-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path></svg><p class="ah-empty-text">No sessions yet. A Claude Code or Copilot session appears here once Agent Inbox’s MCP server starts in it.</p></div><p class="ah-lane-empty" hidden="">No session in this view is working.</p></section><section class="dashboard-card ah-lane quiet-lane" data-ah-lane="quiet" aria-labelledby="quietLaneTitle"><div class="dashboard-card-head ah-lane-head"><h2 id="quietLaneTitle" tabindex="-1">Quiet</h2></div><div class="qt-rows" role="list" aria-label="Quiet sessions" hidden=""><div class="qt-head" aria-hidden="true"><span>State</span><span>Session</span><span>Branch</span><span>Last caption</span><span>Since</span><span></span></div></div><p class="ah-lane-empty">No session in this view is quiet.</p><div class="ah-mesh"></div><div class="ah-folds" hidden=""><details class="ah-fold ah-fold-ended" data-ah-fold="ended" hidden=""><summary data-dashboard-focus-key="ah:fold:ended" data-key="[[&quot;Ended (0)&quot;,true]]"><b>Ended (0)</b></summary><div class="ah-cards"></div><details class="ah-fold ah-fold-earlier" data-ah-fold="earlier" hidden=""><summary data-dashboard-focus-key="ah:fold:earlier" data-key="[[&quot;Earlier sessions (0)&quot;,true]]"><b>Earlier sessions (0)</b></summary><div class="ah-cards"></div></details></details><details class="ah-fold ah-fold-dormant" data-ah-fold="dormant" hidden=""><summary data-dashboard-focus-key="ah:fold:dormant" data-key="[[&quot;Dormant (0)&quot;,true],[&quot; · quiet 8 h or more&quot;,false]]"><b>Dormant (0)</b> · quiet 8 h or more</summary><div class="ah-cards"></div></details><details class="ah-fold ah-fold-closed" data-ah-fold="closed" hidden=""><summary data-dashboard-focus-key="ah:fold:closed" data-key="[[&quot;In closed projects (0)&quot;,true]]"><b>In closed projects (0)</b></summary><div class="ah-cards"></div></details><div class="ah-undelivered" data-key="[[],29742360]"></div></div></section></div><aside id="dashFocus" class="dash-focus" hidden="" aria-labelledby="dashFocusTitle">
