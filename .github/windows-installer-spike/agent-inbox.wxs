<?xml version="1.0" encoding="utf-8"?>
<!--
  #87 installer spike (CI only; nothing here ships): a per-user MSI of the
  verified Windows x64 folder, built by
  .github/workflows/windows-installer-spike.yml with the WiX release pinned in
  tools.json. The workflow passes every $(var.*) value with -d.

  - Per-user and unelevated: Scope="perUser", installed to
    %LOCALAPPDATA%\Programs\Agent Inbox. WiX v6 names that folder
    PerUserProgramFilesFolder; v5 spells it out.
  - The whole folder is harvested with Files, so the installed tree can be
    compared byte for byte with the folder's verified tree digest.
  - The Start-menu shortcut carries the AppUserModelID and the toast activator
    CLSID that Windows notifications need, and the MSI owns the CLSID's
    LocalServer32 registration, so uninstall removes it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="$(var.ProductName)"
    Manufacturer="$(var.Manufacturer)"
    Version="$(var.Version)"
    UpgradeCode="$(var.UpgradeCode)"
    Scope="perUser"
    Language="1033"
    Compressed="yes">
    <SummaryInformation Description="$(var.ProductName) $(var.Version)" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AgentInbox.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AgentInbox.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/shariqh/agent-inbox" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="$(var.ProductName)">
      <Files Directory="INSTALLFOLDER" Include="$(var.AppDir)\**" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="ToastActivator" />
    </Feature>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{5DB23DD7-6096-4B82-9CD9-908AE530B17F}">
        <Shortcut
          Id="AgentInboxShortcut"
          Name="$(var.ProductName)"
          Description="Local attention inbox for coding agents"
          Target="[INSTALLFOLDER]Agent Inbox.exe"
          WorkingDirectory="INSTALLFOLDER">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="$(var.AppUserModelId)" />
          <ShortcutProperty Key="System.AppUserModel.ToastActivatorCLSID" Value="$(var.ToastActivatorClsid)" />
        </Shortcut>
        <RegistryValue
          Root="HKCU"
          Key="Software\$(var.ProductName)\Installer"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- The same values Electron 43 writes for its toast activator, owned by the MSI. -->
    <Component Id="ToastActivator" Directory="INSTALLFOLDER" Guid="{9639C28E-13C4-4208-B66B-550A0CB93154}">
      <RegistryValue
        Root="HKCU"
        Key="Software\Classes\CLSID\$(var.ToastActivatorClsid)"
        Type="string"
        Value="$(var.ProductName) Notification Activator"
        KeyPath="yes" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Classes\CLSID\$(var.ToastActivatorClsid)"
        Name="CustomActivator"
        Type="integer"
        Value="1" />
      <RegistryValue
        Root="HKCU"
        Key="Software\Classes\CLSID\$(var.ToastActivatorClsid)\LocalServer32"
        Type="string"
        Value="&quot;[INSTALLFOLDER]Agent Inbox.exe&quot;" />
    </Component>
  </Package>
</Wix>
