<?xml version="1.0" encoding="utf-8"?>
<!--
  #87 installer spike (CI only): electron-winstaller's default template, except that
  it packs every file of the verified folder. The default packs a fixed list of file
  patterns; build-squirrel.mjs reports which verified files that list would drop.
-->
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id><%- name %></id>
    <title><%- title %></title>
    <version><%- version %></version>
    <authors><%- authors %></authors>
    <owners><%- owners %></owners>
    <iconUrl><%- iconUrl %></iconUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description><%- description %></description>
    <copyright><%- copyright %></copyright>
  </metadata>
  <files>
    <file src="**\*" target="lib\net45" exclude="Squirrel.exe" />
    <file src="Squirrel.exe" target="lib\net45\squirrel.exe" />
  </files>
</package>
