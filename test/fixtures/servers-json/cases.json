{
  "about": "Shared servers.json verdicts (model servers step 1, D1). Run by test/servers-json-parity.test.ts against src/mesh-config.ts and by packages/mesh/test/servers-config.test.ts against the package's reader. A verdict is present, missing, or a refusal reason (SERVERS_REASONS in src/mesh-config.ts). A case writes `doc` (as JSON) or `text` (as is) to <dir>/mesh/servers.json with `mode` (default 0600), or `pad` (a valid file padded to exactly that many bytes), or names a `kind`: symlink (to a valid file), directory or missing. `servers`, when given, is the names a present verdict holds.",
  "files": [
    { "name": "one server with a key file", "doc": { "schema": 1, "servers": { "box": { "baseUrl": "https://box.example/llm", "apiKey": { "file": "/keys/box" } } } }, "verdict": "present", "servers": ["box"] },
    { "name": "every key kind, none included", "doc": { "schema": 1, "servers": {
      "a": { "baseUrl": "https://a.example", "apiKey": { "env": "A_KEY" } },
      "b-2": { "baseUrl": "http://127.0.0.1:8080/v1x", "apiKey": { "command": ["/usr/bin/security", "find-generic-password", "-w"] } },
      "c": { "baseUrl": "http://[::1]:9000" },
      "d": { "baseUrl": "https://d.example", "apiKey": { "file": "~/keys/d" } }
    } }, "verdict": "present", "servers": ["a", "b-2", "c", "d"] },
